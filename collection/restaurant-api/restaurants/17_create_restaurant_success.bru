meta {
  name: Restaurante - Criar (sucesso)
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/restaurants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Cantina do João",
    "address": {
      "street": "Av. Paulista",
      "number": "1000",
      "complement": "Loja 5",
      "city": "São Paulo",
      "state": "SP",
      "zipCode": "01310-100"
    },
    "cuisineType": "Italiana",
    "openingTime": "11:00:00",
    "closingTime": "23:00:00"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("restaurantId", res.body.id);
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("retorna id", function() {
    expect(res.body.id).to.be.a("number");
  });
  test("nome correto", function() {
    expect(res.body.name).to.equal("Cantina do João");
  });
}
