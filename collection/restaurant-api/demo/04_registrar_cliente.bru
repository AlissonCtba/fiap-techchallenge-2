meta {
  name: "[DEMO] 4. Registrar cliente"
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Maria Cliente",
    "login": "maria.cliente",
    "email": "maria@cliente.com",
    "password": "senha123",
    "userTypeId": 2,
    "address": {
      "street": "Av. Paulista",
      "number": "900",
      "city": "São Paulo",
      "state": "SP",
      "zipCode": "01310-200"
    }
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("customerToken", res.body.token);
  }
}

docs {
  ROTEIRO: Registra um usuário do tipo CUSTOMER (id=2).
  Salva o token do cliente para demonstrar restrições de acesso.
}
