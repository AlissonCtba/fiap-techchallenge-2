meta {
  name: Cardápio - Listar itens
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/api/v1/restaurants/{{restaurantId}}/menu
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("retorna página", function() {
    expect(res.body.content).to.be.an("array");
  });
}
