post {
  url: {{baseUrl}}/api/v1/restaurants/{{restaurantId}}/menu
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "",
    "price": -5.00,
    "dineInOnly": false
  }
}

tests {
