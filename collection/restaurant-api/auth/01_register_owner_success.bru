meta {
  name: Cadastro - Dono de restaurante (sucesso)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "João Restaurante",
    "login": "joao.owner",
    "email": "joao@restaurante.com",
    "password": "senha123",
    "userTypeId": 1,
    "address": {
      "street": "Rua das Flores",
      "number": "123",
      "complement": "Sala 1",
      "city": "São Paulo",
      "state": "SP",
      "zipCode": "01310-100"
    }
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("token", res.body.token);
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });
  test("retorna token", function() {
    expect(res.body.token).to.be.a("string");
  });
  test("role é OWNER", function() {
    expect(res.body.role).to.equal("OWNER");
  });
}
