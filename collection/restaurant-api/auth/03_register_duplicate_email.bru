meta {
  name: Cadastro - E-mail duplicado (erro 409)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "João Duplicado",
    "login": "joao.dup",
    "email": "joao@restaurante.com",
    "password": "senha123",
    "userTypeId": 1,
    "address": {
      "street": "Rua X",
      "number": "1",
      "city": "SP",
      "state": "SP",
      "zipCode": "01310-000"
    }
  }
}

tests {
  test("status 409 Conflict", function() {
    expect(res.status).to.equal(409);
  });
  test("RFC 7807 - title presente", function() {
    expect(res.body.title).to.be.a("string");
  });
  test("RFC 7807 - detail presente", function() {
    expect(res.body.detail).to.be.a("string");
  });
}
