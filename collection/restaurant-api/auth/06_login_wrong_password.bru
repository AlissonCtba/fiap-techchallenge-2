meta {
  name: Login - Senha incorreta (erro 401)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "joao@restaurante.com",
    "password": "senhaerrada"
  }
}

tests {
  test("status 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });
  test("RFC 7807 - title presente", function() {
    expect(res.body.title).to.be.a("string");
  });
}
