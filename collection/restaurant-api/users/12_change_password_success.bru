meta {
  name: Senha - Alteração com sucesso
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v1/users/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "oldPassword": "senha123",
    "newPassword": "novaSenha456"
  }
}

tests {
  test("status 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  test("mensagem de sucesso", function() {
    expect(res.body.message).to.equal("Senha alterada com sucesso");
  });
}
