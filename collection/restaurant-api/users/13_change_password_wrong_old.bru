meta {
  name: Senha - Senha antiga incorreta (erro 401)
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/api/v1/users/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "oldPassword": "senhaerrada",
    "newPassword": "qualquerCoisa123"
  }
}

tests {
  test("status 401 Unauthorized", function() {
    expect(res.status).to.equal(401);
  });
  test("RFC 7807 - detail presente", function() {
    expect(res.body.detail).to.be.a("string");
  });
}
