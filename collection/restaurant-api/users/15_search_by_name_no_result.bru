meta {
  name: Busca - Nome sem resultado
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/v1/users/search?name=xyzabcnaoexiste&page=0&size=5
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("lista vazia", function() {
    expect(res.body.content).to.be.an("array").that.is.empty;
  });
}
